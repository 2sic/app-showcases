@inherits AppCode.Razor.AppRazor
@using ToSic.Razor.Blade
@using AppCode
@using AppCode.Data

@{
  var reference = App.Data.GetAll<Reference>().FirstOrDefault(r => r.UrlKey == MyPage.Parameters.String("details"));
  var fancyboxAttribute = Constants.FancyboxPrefix + UniqueKey; 
}

<div class="app-references" @Kit.Toolbar.Default(reference)>
  <div class="row">
    <div class="col-12 col-md-8 col-lg-7">
      <h1>@reference.Title</h1>
      <div class="d-flex gap-1 mb-2">
        <small>@reference.CreateDate.ToString("dd.MM.yyyy")</small>
        @foreach (var category in reference.Categories) {
          <small class="app-references-category text-muted">@category.Title</small>
        }
      </div>
      @Html.Raw(reference.Description)
    </div>
    <div class="col-12 col-md-4 col-lg-5">
      
      <div class="app-references-images effect-zoom mb-2">
        @{
          var picExtendedDescription = reference.File("PreviewImage").Metadata.String("DescriptionExtended", scrubHtml: true);
          var pic = Kit.Image.Picture(reference.Field("PreviewImage"));
          var picTitle = pic.Alt + (Text.Has(picExtendedDescription) ? " - " + picExtendedDescription : "");
        }
        <a href="@reference.PreviewImage" data-fancybox="@fancyboxAttribute" data-caption="@picTitle">
          @pic
        </a>
      </div>

      <div class="app-references-gallery mb-4 mb-md-0">
        @foreach (var image in reference.Folder("Images").Files) {
          var picGalDescription = image.Metadata.String("Description", scrubHtml: true);
          var picGalDescriptionExtended = image.Metadata.String("DescriptionExtended", scrubHtml: true);
          var picGalTitle = picGalDescription + (Text.Has(picGalDescriptionExtended) ? " - " + picGalDescriptionExtended : "");
          
          <div class="app-references-images effect-zoom">
            <a href="@image.Url" data-fancybox="@fancyboxAttribute" data-caption="@picGalTitle">
              @Kit.Image.Picture(image)
            </a>
          </div>
        }
      </div>
    </div>
    <div class="col-md-12">
      <a href="@Link.To()" class="btn btn-primary">@App.Resources.BtnBack</a>
    </div>
  </div>
</div>

@Html.Partial("Assets.cshtml")