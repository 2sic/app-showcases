@inherits AppCode.Razor.AppRazor
@using AppCode.Data

@{
  var viewConfig = As<ViewConfiguration>(MyItem);
  var viewConfigHasCategory = viewConfig.IsNotEmpty("Category");
  
  var categories = App.Data.GetAll<Category>();
  var references = App.Data.GetAll<Reference>();
  
  var categoryParameter = MyPage.Parameters.String("category");

  if (categoryParameter != null) {        
    references = references.Where(r => r.Categories.Select(c => c.UrlKey).Contains(categoryParameter));
  }

  if(viewConfigHasCategory) {
    references = references.Where(r => r.Categories.Contains(viewConfig.Category));
  }

  var tooblar = Kit.Toolbar.Default(MyItem)
    .New("Category", tweak: b => b.Position(1).Tooltip(App.Resources.TooltipNewCategory).Color("gray"))
    .Data("Category", tweak: b => b.Position(2).Tooltip(App.Resources.TooltipCategories).Color("gray"));
}

<div class="app-references" @tooblar>
  <div class="row">
    <div class="col-md-12">
      <h1>@viewConfig.Title</h1>
    </div>

    @if(!viewConfigHasCategory) {
      <div class="app-references-category-filter mb-2">
        <a href="@Link.To()" class="btn @(categoryParameter != null ? "btn-outline-primary" : "btn-primary")">@App.Resources.FilterAll</a>
        @foreach (var category in categories) {
          var activeBtnClass = categoryParameter == category.UrlKey ? "btn-primary" : "btn-outline-primary";
          <a href="@Link.To(parameters: "category=" + category.UrlKey)" class="btn @activeBtnClass">@category.Title</a>
        }
      </div>
    }
    
      
    @foreach (var reference in references.OrderByDescending(r => r.CreateDate)) {
      <div class="col-12 col-md-6 col-lg-4 mb-4 mb-md-0">
        <div class="app-references-item position-relative" @Kit.Toolbar.Default(reference)>
          <figure class="app-references-image effect-zoom">
            @Kit.Image.Picture(reference.Field("PreviewImage"), imgAlt: reference.Title)
          </figure>
          
          <h2>@reference.Title</h2>
          <div class="d-flex gap-1 mb-2">
            <small>@reference.CreateDate.ToString("dd.MM.yyyy")</small>
            @foreach(var category in reference.Categories) {
              <small class="app-references-category text-muted">@category.Title</small>
            }
          </div>
          <p>@reference.ShortDescription</p>
          
          <a href="@Link.To(parameters: "details=" + reference.UrlKey)" class="btn btn-primary stretched-link">@App.Resources.BtnDetails</a>
        </div>
      </div>
    }
  </div>
</div>

@Html.Partial("Assets.cshtml")
